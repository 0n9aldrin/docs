{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PhotoMem",
  "colors": {
    "primary": "#00D9FF",
    "light": "#00D9FF",
    "dark": "#0A0F1E"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "index",
              "introduction",
              "quickstart",
              "installation"
            ]
          },
          {
            "group": "Core",
            "pages": [
              "core-concepts",
              "development"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/python"
            ]
          },
          {
            "group": "AI Tools",
            "pages": [
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "SDK",
            "pages": [
              "api-reference/memory",
              "api-reference/types",
              "api-reference/errors"
            ]
          },
          {
            "group": "REST API",
            "pages": [
              "api-reference/rest-api"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/yourusername/photomem",
          "icon": "github"
        },
        {
          "anchor": "Community",
          "href": "https://discord.gg/photomem",
          "icon": "discord"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@photomem.ai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://github.com/photomem/photomem"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/yourusername/photomem",
      "twitter": "https://twitter.com/photomem",
      "discord": "https://discord.gg/photomem"
    }
  }
}
