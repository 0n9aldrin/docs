  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT token from Clerk authentication"
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "API key for memory operations (format: pm_live_xxx or pm_test_xxx)"
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Unauthorized",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "NotFoundError": {
        "description": "Not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      },
      "PayloadTooLargeError": {
        "description": "Payload too large",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "MemoryCreateRequest": {
        "type": "object",
        "required": ["userId", "userName", "content"],
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "User ID"
          },
          "userName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "User name"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "description": "Memory content (max 10KB)"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 50
            },
            "maxItems": 20,
            "description": "Tags for categorization"
          }
        }
      },
      "MemoryResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
