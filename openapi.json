{
  "openapi": "3.0.1",
  "info": {
    "title": "PhotoMem API",
    "description": "PhotoMem is a self-improving memory layer for LLM applications, enabling personalized AI experiences that save costs and delight users.",
    "contact": {
      "email": "support@photomem.ai"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://api.photomem.ai",
      "description": "Production server"
    },
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    },
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/v1/memories": {
      "post": {
        "tags": ["Memory Management"],
        "summary": "Create Memory",
        "description": "Create a new memory entry for a user. The memory is automatically embedded using AI models and indexed in the vector database for semantic search. Supports deduplication based on content hash to prevent duplicate memories.",
        "operationId": "create_memory",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemoryCreateRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic memory creation",
                  "value": {
                    "userId": "user_123",
                    "userName": "Alice Johnson",
                    "content": "Alice prefers morning meetings and likes coffee without sugar.",
                    "tags": ["preferences", "meetings"]
                  }
                },
                "with_tags": {
                  "summary": "Memory with multiple tags",
                  "value": {
                    "userId": "user_456",
                    "userName": "Bob Smith",
                    "content": "Bob is working on the Q1 product launch and needs design review by Friday.",
                    "tags": ["projects", "deadlines", "q1-launch"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Memory created successfully. Returns the created memory with generated ID and timestamps.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryCreateResponse"
                },
                "examples": {
                  "success": {
                    "summary": "Successful creation",
                    "value": {
                      "memory": {
                        "id": "mem_abc123xyz",
                        "userId": "user_123",
                        "userName": "Alice Johnson",
                        "content": "Alice prefers morning meetings and likes coffee without sugar.",
                        "tags": ["preferences", "meetings"],
                        "createdAt": "2024-01-20T10:30:00Z",
                        "updatedAt": "2024-01-20T10:30:00Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request. Invalid input data such as empty content, userId/userName too long, or too many tags.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "validation_error": {
                    "summary": "Validation error",
                    "value": {
                      "error": {
                        "code": "invalid_request",
                        "message": "Maximum 20 tags allowed"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "413": {
            "description": "Payload too large. Memory content exceeds the 10KB limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "examples": {
                  "content_too_large": {
                    "summary": "Content too large",
                    "value": {
                      "error": {
                        "code": "content_too_large",
                        "message": "Content exceeds 10KB limit"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "x-codeSamples": [
          {
            "lang": "Python",
            "source": "import requests\n\nresponse = requests.post(\n    'https://api.photomem.ai/api/v1/memories',\n    headers={'X-API-Key': 'pm_live_YOUR_API_KEY'},\n    json={\n        'userId': 'user_123',\n        'userName': 'Alice Johnson',\n        'content': 'Alice prefers morning meetings and likes coffee without sugar.',\n        'tags': ['preferences', 'meetings']\n    }\n)\n\nmemory = response.json()['memory']\nprint(f\"Created memory: {memory['id']}\")"
          },
          {
            "lang": "JavaScript",
            "source": "const response = await fetch('https://api.photomem.ai/api/v1/memories', {\n  method: 'POST',\n  headers: {\n    'X-API-Key': 'pm_live_YOUR_API_KEY',\n    'Content-Type': 'application/json'\n  },\n  body: JSON.stringify({\n    userId: 'user_123',\n    userName: 'Alice Johnson',\n    content: 'Alice prefers morning meetings and likes coffee without sugar.',\n    tags: ['preferences', 'meetings']\n  })\n});\n\nconst { memory } = await response.json();\nconsole.log(`Created memory: ${memory.id}`);"
          },
          {
            "lang": "cURL",
            "source": "curl -X POST https://api.photomem.ai/api/v1/memories \\\n  -H 'X-API-Key: pm_live_YOUR_API_KEY' \\\n  -H 'Content-Type: application/json' \\\n  -d '{\n    \"userId\": \"user_123\",\n    \"userName\": \"Alice Johnson\",\n    \"content\": \"Alice prefers morning meetings and likes coffee without sugar.\",\n    \"tags\": [\"preferences\", \"meetings\"]\n  }'"
          }
        ]
      },
      "get": {
        "tags": ["Memory Management"],
        "summary": "List Memories",
        "description": "Retrieve a paginated list of memories with optional filtering by user ID and tags. Supports sorting by creation or update time. Results are capped at 100 per request for performance.",
        "operationId": "list_memories",
        "parameters": [
          {
            "name": "userId",
            "in": "query",
            "description": "Filter memories by user ID. Returns only memories for the specified user.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "user_123"
          },
          {
            "name": "tags",
            "in": "query",
            "description": "Filter by tags. Comma-separated list. Returns memories that have ANY of the specified tags.",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "preferences,meetings"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of memories to return. Automatically clamped to 100.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "example": 20
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Number of memories to skip for pagination. Use with limit for paging through results.",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "minimum": 0
            },
            "example": 0
          },
          {
            "name": "sortBy",
            "in": "query",
            "description": "Field to sort by. Options: 'createdAt' or 'updatedAt'.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["createdAt", "updatedAt"],
              "default": "createdAt"
            },
            "example": "createdAt"
          },
          {
            "name": "sortOrder",
            "in": "query",
            "description": "Sort order. Options: 'asc' (oldest first) or 'desc' (newest first).",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["asc", "desc"],
              "default": "desc"
            },
            "example": "desc"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved list of memories with pagination metadata.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MemoryListResponse"
                },
                "examples": {
                  "with_results": {
                    "summary": "List with memories",
                    "value": {
                      "memories": [
                        {
                          "id": "mem_abc123",
                          "userId": "user_123",
                          "userName": "Alice Johnson",
                          "content": "Alice prefers morning meetings and likes coffee without sugar.",
                          "tags": ["preferences", "meetings"],
                          "createdAt": "2024-01-20T10:30:00Z",
                          "updatedAt": "2024-01-20T10:30:00Z"
                        }
                      ],
                      "pagination": {
                        "total": 156,
                        "limit": 20,
                        "offset": 0,
                        "hasMore": true
                      }
                    }
                  },
                  "empty": {
                    "summary": "Empty list",
                    "value": {
                      "memories": [],
                      "pagination": {
                        "total": 0,
                        "limit": 20,
                        "offset": 0,
                        "hasMore": false
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        },
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "x-codeSamples": [
          {
            "lang": "Python",
            "source": "import requests\n\nresponse = requests.get(\n    'https://api.photomem.ai/api/v1/memories',\n    headers={'X-API-Key': 'pm_live_YOUR_API_KEY'},\n    params={\n        'userId': 'user_123',\n        'limit': 20,\n        'offset': 0\n    }\n)\n\ndata = response.json()\nprint(f\"Found {data['pagination']['total']} memories\")\nfor memory in data['memories']:\n    print(f\"  - {memory['id']}: {memory['content'][:50]}...\")"
          },
          {
            "lang": "JavaScript",
            "source": "const response = await fetch(\n  'https://api.photomem.ai/api/v1/memories?userId=user_123&limit=20&offset=0',\n  {\n    headers: {'X-API-Key': 'pm_live_YOUR_API_KEY'}\n  }\n);\n\nconst data = await response.json();\nconsole.log(`Found ${data.pagination.total} memories`);\ndata.memories.forEach(memory => {\n  console.log(`  - ${memory.id}: ${memory.content.substring(0, 50)}...`);\n});"
          },
          {
            "lang": "cURL",
            "source": "curl -X GET 'https://api.photomem.ai/api/v1/memories?userId=user_123&limit=20&offset=0' \\\n  -H 'X-API-Key: pm_live_YOUR_API_KEY'"
          }
        ]
      }
    },
